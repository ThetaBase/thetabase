# The Control Plane. Exactly one per environment — it is the component that is
# *supposed* to know about every project, which is why it is excluded from
# `one_project_per_process.rs` and why it is the one thing here that must not be
# replicated casually.

FROM rust:1.90-bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends capnproto \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
# `sdk/rust` is a workspace member, so cargo refuses to load the workspace
# without it even though nothing here builds it. Omitting it fails at manifest
# load, before a single crate compiles.
COPY sdk/rust/ sdk/rust/

# `kms` is on: the Control Plane is the only component that wraps key material,
# and the feature exists so a self-hosted build does not carry an AWS SDK it
# will never call. A hosted deployment always calls it.
RUN cargo build --release --locked -p theta-control --features kms

FROM gcr.io/distroless/cc-debian12:nonroot
USER nonroot:nonroot

COPY --from=build /src/target/release/theta-control /usr/local/bin/theta-control

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/theta-control"]
